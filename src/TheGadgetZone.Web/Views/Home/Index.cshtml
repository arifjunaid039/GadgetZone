@using TheGadgetZone.Business.Entities
@{
    ViewData["Title"] = "Tech accessories for everyday";
    var categories = (IReadOnlyList<Category>)ViewBag.Categories;
    var products = (IReadOnlyList<Product>)ViewBag.Products;
}

<section class="hero-panel rounded-4 p-4 p-lg-5 mb-5">
    <div class="row align-items-center">
        <div class="col-lg-7">
            <p class="text-uppercase fw-bold text-info mb-2">The Gadget Zone Official</p>
            <h1 class="display-4 fw-bold">Small upgrades. Big difference.</h1>
            <p class="lead">Discover everyday tech accessories, from earbuds and chargers to gaming gear.</p>
            <a class="btn btn-info btn-lg" asp-controller="Products" asp-action="Index">Explore products</a>
        </div>
        <div class="col-lg-5 text-center mt-4 mt-lg-0">
            <div class="hero-icon" aria-hidden="true">⌁</div>
        </div>
    </div>
</section>

<section class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Shop by category</h2>
        <a asp-controller="Products" asp-action="Index">View all</a>
    </div>
    <div class="row g-3">
        @foreach (var category in categories)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <a class="category-tile" asp-controller="Products" asp-action="Index" asp-route-categoryId="@category.Id">@category.Name</a>
            </div>
        }
    </div>
</section>

<section>
    <h2 class="mb-3">Featured products</h2>
    <div class="row g-3">
        @foreach (var product in products.Take(4))
        {
            <div class="col-12 col-sm-6 col-lg-3">
                <div class="card product-card h-100">
                    <img class="card-img-top product-image" src="@(product.ImageUrl ?? "/images/product-placeholder.svg")" alt="@product.Name" />
                    <div class="card-body d-flex flex-column">
                        <span class="small text-muted">@product.Category.Name</span>
                        <h3 class="h5 mt-1">@product.Name</h3>
                        <p class="fw-bold mt-auto">PKR @product.Price.ToString("N2")</p>
                        <a class="btn btn-outline-primary" asp-controller="Products" asp-action="Details" asp-route-id="@product.Id">View details</a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>
