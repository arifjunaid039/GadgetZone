@using TheGadgetZone.Business.Entities
@model IReadOnlyList<Product>
@{
    ViewData["Title"] = "Products";
    var categories = (IReadOnlyList<Category>)ViewBag.Categories;
}

<h1 class="mb-3">Shop accessories</h1>
<form method="get" class="row g-2 mb-4">
    <div class="col-md-6">
        <label class="visually-hidden" for="search">Search products</label>
        <input id="search" class="form-control" type="search" name="search" value="@ViewBag.Search" placeholder="Search products..." />
    </div>
    <div class="col-md-4">
        <label class="visually-hidden" for="categoryId">Category</label>
        <select id="categoryId" class="form-select" name="categoryId">
            <option value="">All categories</option>
            @foreach (var category in categories)
            {
                <option value="@category.Id" selected="@(ViewBag.CategoryId == category.Id)">@category.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2"><button class="btn btn-primary w-100" type="submit">Search</button></div>
</form>

@if (Model.Count == 0)
{
    <p>No products found. Try another search or category.</p>
}
<div class="row g-3">
    @foreach (var product in Model)
    {
        <div class="col-12 col-sm-6 col-lg-3">
            <div class="card product-card h-100">
                <img class="card-img-top product-image" src="@(product.ImageUrl ?? "/images/product-placeholder.svg")" alt="@product.Name" />
                <div class="card-body d-flex flex-column">
                    <span class="small text-muted">@product.Category.Name</span>
                    <h2 class="h5 mt-1">@product.Name</h2>
                    <p class="fw-bold mt-auto">PKR @product.Price.ToString("N2")</p>
                    <p class="small">@(product.StockQuantity > 0 ? $"{product.StockQuantity} in stock" : "Out of stock")</p>
                    <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@product.Id">Details</a>
                </div>
            </div>
        </div>
    }
</div>
